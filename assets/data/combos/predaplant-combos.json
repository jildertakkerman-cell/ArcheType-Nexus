        "combo2": {
            "title": "One-Card Longinephila into Crystal Wing & Dragostapelia",
            "description": "A single Predaplant Longinephila chains through Predaprimitive, Byblisp, and Lilizard to build three Synchros in a row (Bal Teah, Bramble/Black Rose, and Crystal Wing Synchro Dragon), then pivots into Super Duper Polymerization and Polymerization to Fusion Summon Predaplant Ambulomelides and Predaplant Dragostapelia — all while drawing a second Nibiru, the Primal Being to hold live as a hand trap for the opponent's turn.",
            "credits": "✨ Combo by Witherfroakie",
            "date": "July 27, 2026",
            "cards": [
                {
                    "id": "p1-card-000",
                    "name": "Predaplant Longinephila",
                    "type": "monster",
                    "zone": "zone-hand"
                },
                {
